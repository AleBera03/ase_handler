#!/bin/bash

help(){
	echo "Usage:"
	echo " ase_sim [OPTIONS] [--]"
	echo " ase_sim [OPTIONS]"
	echo " ase_sim -a|--add=<file>"
	echo " ase_sim -l|--latencies=<arg1><arg2>...<arg6>"
	echo " ase_sim -a|--add=<file> -l|--latencies=<arg1><arg2>...<arg6>"
	echo " ase_sim -o|-out"
	echo " ase_sim -o|-out -t"
	echo " ase_sim -i|--in=<folder_dest>"
	echo "Options:"
	echo -e " -h --help \t Show this screen"
	echo -e " -a --add = <file> \t Add a new program (it should not exist yet)"
	echo -e " -lt --latencies = <arg1><arg2>...<arg6> \t Set the latencies"
	echo -e " -t --table \t Produce the pipeline table in .xlsx file (only for WSL2 users) toward Documents folder in windows"
	echo -e " -i --in = <folder_dest> \t Path to move all results file (do not confuse with simulate.sh option)"
	echo -e " -o --out \t Simulate program with out of order architecture (using Konata)"
}

modify_latency(){
	if [[ "$#" -ne 6 ]]; then
		echo "Wrong number of args"
		help
		exit 1
	fi
	arg=("$@")
	for par in "${arg[@]}"; do
        	if [[ ! $par  =~ ^[1-9][0-9]*$  ]]; then
					echo "Wrong arguments"
					help
                	exit 1
        	fi
	done
	latencies=('INTEGER_ALU_LATENCY'\
		'INTEGER_MUL_LATENCY' \
		'INTEGER_DIV_LATENCY' \
		'FLOAT_ALU_LATENCY' \
		'FLOAT_MUL_LATENCY' \
		'FLOAT_DIV_LATENCY')
	for ((i=0; i<"${#latencies[@]}"; i++)); do
        	lat="${latencies[$i]}"
        	val="${arg[$i]}"
        	sed -i "s/^$lat = .*/$lat = $val/" "$ASEDIR/gem5/riscv_in_order_hen_patt.py"
    	done
	sed -i 's/\r//' "$ASEDIR/gem5/riscv_in_order_hen_patt.py"
}

add_program(){
	# extract basename
	DIR="$1"
	FILENAME=${DIR##*/}
	BASENAME=${FILENAME%%.[sc]}
	# if program does not exist yet
	if [[ ! -d "$ASEDIR/programs/$BASENAME" ]]; then
		ase_add $DIR 
	fi
	sim_option="-i $ASEDIR/programs/$BASENAME $sim_option"
}

set_outorder(){
	cp "$ASEDIR/setup_default" "$ASEDIR/setup_default_mod"
	sed -i 's/export GEM5_CPU_IN_ORDER=true/export GEM5_CPU_IN_ORDER=false/' "$ASEDIR/setup_default_mod"
	# set riscv_o3_custom
	gem5script="$ASEDIR/gem5/riscv_o3_custom.py"
	sed -i "s|export GEM5_SIMULATION_SCRIPT=\"\.\/gem5\/riscv_in_order_hen_patt\.py\"|#&|" "$ASEDIR/setup_default_mod"
	sed -i "s|#export GEM5_SIMULATION_SCRIPT=\"\.\/gem5\/riscv_o3_custom\.py\"|export GEM5_SIMULATION_SCRIPT=\"./gem5/riscv_o3_custom.py\"|" "$ASEDIR/setup_default_mod"
	sed -i "s|export PIPELINE_VISUALIZER=.*|export PIPELINE_VISUALIZER=$KONATADIR/konata|" "$ASEDIR/setup_default_mod"
	# choose a BP
	predictors=('LocalBP' 'TournamentBP' 'BiModeBP')
	ind=0
	for i in "${predictors[@]}"; do
		echo -e "$ind) \t $i"
		((ind++))
	done
	read -rp "Choose a BP: " ans
	if [[ ! $ans =~ ^[0-2]$ ]]; then
		echo "Wrong number"
		exit 1
	fi
	BP="create_${predictors[$ans]}()"
	while true; do
		read -rp "Configure create_predictor.py [y/n]: " ans
		if [[ $ans =~ ^[ynYN]$ ]]; then
			break
		fi
    	echo "Please enter 'y' or 'n'"
	done
	if [[ $ans == "y" ]]; then
		vim "$ASEDIR/gem5/create_predictor.py"	
	fi
	sed -i "s/the_cpu.branchPred = predictor.*/the_cpu.branchPred = predictor.$BP/" $gem5script
	sim_option="$sim_option -s $ASEDIR/setup_default_mod"
	trace_out="trace.out"
}

WORKDIR="$(pwd)"
folder_dest="$WORKDIR"

# getting options
flag_gen=0
flagi=0
sim_option=""
trace_out="gem5_inorder.log"
while [[ "$1" =~ ^- && ! "$1" == "--" ]]; do jump=1; case $1 in
  	-a | --add )
		shift
		if [[ ! -f $1 ]]; then
			echo "No such file"
			help
			exit 1
		fi
		add_program $1
		;;
	-i | --in )
		shift
		flagi=1
		folder_dest=$1
		if [[ ! -d $folder_dest ]]; then
			mkdir $folder_dest
		fi
		;;
  	-lt | --latencies )
		shift
		arg=("${@:1:6}")
		modify_latency "${arg[@]}"
		jump=6
		;;
	-t | --table )
		if [[ -n $(echo uname -r | grep -e "WSL2") ]]; then
			echo "This kernel is wrong"
			exit 1
		fi
		if [[ -n $(cat /etc/wsl.conf | tr -d " " | grep -e "appendWinsowsPath=false") ]]; then
			echo "Windows PATH not included"
			exit 1
		fi
		if [[ -z $(which python3) ]]; then
			echo "python3 is missing"
			exit
		fi
		gen_flag=1
		;;
	-o | --out )
		echo $ASEDIR
		set_outorder
		;;
	-h | --help )
		help
		exit
		;;
	* )
		echo "Wrong option"
		help
		exit 1
esac; shift $jump; done
if [[ "$1" == '--' ]]; then shift; fi
if [[ -n $1 ]]; then
	echo "Wrong option"
	exit 1
fi


# launch sim
cd $ASEDIR
echo "simulate.sh $sim_option"
source simulate.sh $sim_option

if [[ $? -ne 0 ]]; then
	echo "Something gone wrong during simulation"
	exit 1
fi

# final print
cd "$WORKDIR"
cp -v "$ASEDIR/results/$program/stats.txt" "$folder_dest/stats_$program.txt"
cp -v "$ASEDIR/results/$program/$trace_out" "$folder_dest/$trace_out"
cp -v "$ASEDIR/programs/$program/$program.dump" "$folder_dest/$program.dump"
# create pipeline table
if [[ -f "$ASEDIR/programs/$program/$program.s" ]]; then
	python3 "$ASEMANAGEPROGRAM/generate_pipeline_table.py" "$ASEDIR/programs/$program/$program.s"
	if [[ $gen_flag -eq 1 ]]; then
		echo -e "\n #################### Opening excel file ################### \n"
		DIRUSER=$(cmd.exe /c echo %USERPROFILE% | tr -d '\r')
		WINUSER="${DIRUSER##*\\}"
		mv "$ASEDIR/programs/$program/$program.xlsx" "/mnt/c/Users/$WINUSER/Documents/$program.xlsx"
		# view doc https://learn.microsoft.com/it-it/windows/wsl/filesystems
		powershell.exe start "C:\\Users\\$WINUSER\\Documents\\$program.xlsx"
	else
		mv "$ASEDIR/programs/$program/$program.xlsx" "$folder_dest/$program.xlsx"
	fi
fi
echo -e "\n ######################## Latencies ######################### \n"
latencies=('INTEGER_ALU_LATENCY'\
		'INTEGER_MUL_LATENCY' \
		'INTEGER_DIV_LATENCY' \
		'FLOAT_ALU_LATENCY' \
		'FLOAT_MUL_LATENCY' \
		'FLOAT_DIV_LATENCY')
for ((i=0; i<"${#latencies[@]}"; i++)); do
	lat="${latencies[$i]}"
	echo "$(grep -e "^$lat = [0-9]*$" "$ASEDIR/gem5/riscv_in_order_hen_patt.py")"
done